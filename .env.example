DATABASE_URL="postgresql://huginn:huginn_local_only@127.0.0.1:54329/huginn?schema=public"
APP_ORIGIN="http://localhost:3000"
API_HOST="127.0.0.1"
API_PORT="4000"
API_INTERNAL_URL="http://127.0.0.1:4000"
NODE_ENV="development"
SESSION_DAYS="7"
# The built-in development engine always fails explicitly; it never claims a real solution.
SOLVER_PROVIDER="disabled"
SOLVER_URL=""
SOLVER_SECRET=""
TASK_PRICE_MICRO_USD="2000"
# Tariff and PAYMENT_* seed the database once; subsequent edits use /app/admin.
TASK_TIMEOUT_SECONDS="300"
WORKER_CONCURRENCY="5"
TRUSTED_PROXIES="127.0.0.1,::1"
# Compose uses SOLVER_PROVIDER=mimic and an internal SOLVER_URL.
# Use a secret of at least 32 characters for the Mimic adapter.
# Optional external payment adapter. Wallet credits require a signed confirmed webhook.
PAYMENT_PROVIDER="disabled"
PAYMENT_URL=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
# Stable encryption key for write-only payment credentials stored in the database.
SETTINGS_ENCRYPTION_KEY=""
# Seed is explicitly opt-in and forbidden in production.
DEMO_MODE="false"
DEMO_PASSWORD=""
